/* Gaya pagination di tampilan depan */
.page-numbers,
.pagination a {
  display: inline-block;
  padding: 8px 14px;
  margin: 0 4px;
  border-radius: 6px;
  background-color: #f3f3f3;
  color: #333;
  text-decoration: none;
  transition: all 0.3s ease;
}

.page-numbers:hover,
.pagination a:hover {
  background-color: #0073aa;
  color: #fff;
}

.page-numbers.current {
  background-color: #0073aa;
  color: #fff;
  font-weight: bold;
}
